# ---- LLM (Node 2 gatekeeper + Node 3 translator; OpenAI-compatible endpoint) ----
# House config: opencode-go → deepseek-v4.1-flash (llm.py sends the required
# x-opencode-session header automatically). Bump PROCESS_MODEL to deepseek-v4-pro for heavier translation.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
GATEKEEPER_MODEL=deepseek-v4.1-flash
PROCESS_MODEL=deepseek-v4.1-flash

# ---- Search API (optional; Google News RSS works without it) ----
SERPER_API_KEY=
TAVILY_API_KEY=

# ---- Supabase (backend writes use service_role; frontend uses anon) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Frontend (also set in frontend/.env.local as NEXT_PUBLIC_*) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Telegram weekly briefing (Node 4) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
